# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password required to sign in to /admin
ADMIN_PASSWORD="change-me-to-a-secret-password"

# JWT_SECRET: Long random string used to sign httpOnly admin session cookies
JWT_SECRET="change-me-to-a-long-random-secret-key"
